; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=24

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Lumina Nebulae"
config/version="0.1"
run/main_scene="uid://dxrkoq4lgu83"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=24
boot_splash/bg_color=Color(0.105882354, 0.050980393, 0.20784314, 1)
boot_splash/show_image=false
config/icon="uid://jrnb1t7olj"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/size/viewport_width=240
window/size/viewport_height=180
window/size/mode=2
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Cultist Adventure"

[editor]

movie_writer/fps=24

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "green",
"res://assets/audio/": "blue",
"res://assets/fonts/": "teal",
"res://resources/": "red",
"res://scenes/": "yellow",
"res://scripts/": "blue"
}

[global_group]

ui_button=""
player=""
save_manager=""
event_manager=""
scene_manager=""
animation_manager=""
audio_manager=""
input_manager=""
settings_manager=""

[gui]

theme/custom="uid://b8cbbtumtb460"
theme/custom_font="res://assets/fonts/pixeloid_sans_bold.ttf"

